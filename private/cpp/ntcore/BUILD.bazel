load("@rules_cc//cc:defs.bzl", "cc_library")

alias(
    name = "header_files",
    actual = "@bazelrio_org_wpilib_ntcore_ntcore-cpp_headers//:header_files",
    visibility = ["@bzlmodrio-allwpilib//:__subpackages__"],
)

cc_library(
    name = "shared_interface",
    srcs = select({
        "@wpilib_toolchains//conditions:windows_arm64": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_windowsarm64//:shared_interface"],
        "@wpilib_toolchains//conditions:windows_arm64_debug": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_windowsarm64debug//:shared_interface"],
        "@wpilib_toolchains//conditions:windows_x86_64": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_windowsx86-64//:shared_interface"],
        "@wpilib_toolchains//conditions:windows_x86_64_debug": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_windowsx86-64debug//:shared_interface"],
    }),
    linkstatic = True,
    tags = ["manual"],
    visibility = ["@bzlmodrio-allwpilib//:__subpackages__"],
    deps = ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_headers//:headers"],
)

filegroup(
    name = "shared_raw",
    srcs = select({
        "@wpilib_toolchains//conditions:linux_x86_64": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_linuxx86-64//:shared"],
        "@wpilib_toolchains//conditions:linux_x86_64_debug": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_linuxx86-64debug//:shared"],
        "@wpilib_toolchains//conditions:osx": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_osxuniversal//:shared"],
        "@wpilib_toolchains//conditions:osx_debug": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_osxuniversaldebug//:shared"],
        "@wpilib_toolchains//conditions:windows_arm64": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_windowsarm64//:shared"],
        "@wpilib_toolchains//conditions:windows_arm64_debug": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_windowsarm64debug//:shared"],
        "@wpilib_toolchains//conditions:windows_x86_64": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_windowsx86-64//:shared"],
        "@wpilib_toolchains//conditions:windows_x86_64_debug": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_windowsx86-64debug//:shared"],
        "@wpilib_toolchains//constraints/is_systemcore:systemcore": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_linuxsystemcore//:shared"],
        "@wpilib_toolchains//constraints/is_systemcore:systemcore_debug": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_linuxsystemcoredebug//:shared"],
        "@wpilib_toolchains//constraints/is_trixie64:trixie64": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_linuxarm64//:shared"],
        "@wpilib_toolchains//constraints/is_trixie64:trixie64_debug": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_linuxarm64debug//:shared"],
        "//conditions:default": [],
    }),
    visibility = ["@bzlmodrio-allwpilib//:__subpackages__"],
)

cc_library(
    name = "shared",
    srcs = [":shared_raw"],
    visibility = ["@bzlmodrio-allwpilib//:__subpackages__"],
    deps = [
        "@bzlmodrio-allwpilib//libraries/cpp/datalog:shared",
        "@bzlmodrio-allwpilib//libraries/cpp/wpinet:shared",
        "@bzlmodrio-allwpilib//libraries/cpp/wpiutil:shared",
    ] + select({
        "@wpilib_toolchains//conditions:windows_arm64": [":shared_interface"],
        "@wpilib_toolchains//conditions:windows_x86_64": [":shared_interface"],
        "//conditions:default": [],
    }) + ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_headers//:headers"],
    alwayslink = 1,
)

cc_library(
    name = "static",
    linkstatic = 1,
    visibility = ["@bzlmodrio-allwpilib//:__subpackages__"],
    deps = ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_headers//:headers"] + select({
        "@wpilib_toolchains//conditions:linux_x86_64": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_linuxx86-64static//:static_libs"],
        "@wpilib_toolchains//conditions:linux_x86_64_debug": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_linuxx86-64staticdebug//:static_libs"],
        "@wpilib_toolchains//conditions:osx": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_osxuniversalstatic//:static_libs"],
        "@wpilib_toolchains//conditions:osx_debug": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_osxuniversalstaticdebug//:static_libs"],
        "@wpilib_toolchains//conditions:windows_arm64": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_windowsarm64static//:static_libs"],
        "@wpilib_toolchains//conditions:windows_arm64_debug": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_windowsarm64staticdebug//:static_libs"],
        "@wpilib_toolchains//conditions:windows_x86_64": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_windowsx86-64static//:static_libs"],
        "@wpilib_toolchains//conditions:windows_x86_64_debug": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_windowsx86-64staticdebug//:static_libs"],
        "@wpilib_toolchains//constraints/is_systemcore:systemcore": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_linuxsystemcorestatic//:static_libs"],
        "@wpilib_toolchains//constraints/is_systemcore:systemcore_debug": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_linuxsystemcorestaticdebug//:static_libs"],
        "@wpilib_toolchains//constraints/is_trixie64:trixie64": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_linuxarm64static//:static_libs"],
        "@wpilib_toolchains//constraints/is_trixie64:trixie64_debug": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_linuxarm64staticdebug//:static_libs"],
    }),
)

cc_library(
    name = "jni",
    srcs = select({
        "@wpilib_toolchains//conditions:linux_x86_64": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_linuxx86-64//:jni"],
        "@wpilib_toolchains//conditions:linux_x86_64_debug": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_linuxx86-64debug//:jni"],
        "@wpilib_toolchains//conditions:osx": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_osxuniversal//:jni"],
        "@wpilib_toolchains//conditions:osx_debug": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_osxuniversaldebug//:jni"],
        "@wpilib_toolchains//conditions:windows_arm64": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_windowsarm64//:jni"],
        "@wpilib_toolchains//conditions:windows_arm64_debug": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_windowsarm64debug//:jni"],
        "@wpilib_toolchains//conditions:windows_x86_64": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_windowsx86-64//:jni"],
        "@wpilib_toolchains//conditions:windows_x86_64_debug": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_windowsx86-64debug//:jni"],
        "@wpilib_toolchains//constraints/is_systemcore:systemcore": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_linuxsystemcore//:jni"],
        "@wpilib_toolchains//constraints/is_systemcore:systemcore_debug": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_linuxsystemcoredebug//:jni"],
        "@wpilib_toolchains//constraints/is_trixie64:trixie64": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_linuxarm64//:jni"],
        "@wpilib_toolchains//constraints/is_trixie64:trixie64_debug": ["@bazelrio_org_wpilib_ntcore_ntcore-cpp_linuxarm64debug//:jni"],
    }),
    linkstatic = 1,
    visibility = ["@bzlmodrio-allwpilib//:__subpackages__"],
    deps = [
        ":shared",
        "@bazelrio_org_wpilib_ntcore_ntcore-cpp_headers//:headers",
    ],
)
