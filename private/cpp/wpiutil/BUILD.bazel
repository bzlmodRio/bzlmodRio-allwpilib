load("@rules_cc//cc:defs.bzl", "cc_library")

alias(
    name = "header_files",
    actual = "@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_headers//:header_files",
    visibility = ["@bzlmodrio-allwpilib//:__subpackages__"],
)

cc_library(
    name = "shared_interface",
    srcs = select({
        "@rules_bzlmodrio_toolchains//conditions:windows_arm64": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_windowsarm64//:shared_interface"],
        "@rules_bzlmodrio_toolchains//conditions:windows_arm64_debug": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_windowsarm64debug//:shared_interface"],
        "@rules_bzlmodrio_toolchains//conditions:windows_x86_64": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_windowsx86-64//:shared_interface"],
        "@rules_bzlmodrio_toolchains//conditions:windows_x86_64_debug": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_windowsx86-64debug//:shared_interface"],
    }),
    linkstatic = True,
    tags = ["manual"],
    target_compatible_with = select({
        "@rules_bzlmodrio_toolchains//constraints/is_roborio:roborio": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    visibility = ["@bzlmodrio-allwpilib//:__subpackages__"],
    deps = ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_headers//:headers"],
)

filegroup(
    name = "shared_raw",
    srcs = select({
        "@rules_bzlmodrio_toolchains//conditions:linux_x86_64": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_linuxx86-64//:shared"],
        "@rules_bzlmodrio_toolchains//conditions:linux_x86_64_debug": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_linuxx86-64debug//:shared"],
        "@rules_bzlmodrio_toolchains//conditions:osx": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_osxuniversal//:shared"],
        "@rules_bzlmodrio_toolchains//conditions:osx_debug": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_osxuniversaldebug//:shared"],
        "@rules_bzlmodrio_toolchains//conditions:windows_arm64": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_windowsarm64//:shared"],
        "@rules_bzlmodrio_toolchains//conditions:windows_arm64_debug": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_windowsarm64debug//:shared"],
        "@rules_bzlmodrio_toolchains//conditions:windows_x86_64": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_windowsx86-64//:shared"],
        "@rules_bzlmodrio_toolchains//conditions:windows_x86_64_debug": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_windowsx86-64debug//:shared"],
        "@rules_bzlmodrio_toolchains//constraints/is_bookworm64:bookworm64": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_linuxarm64//:shared"],
        "@rules_bzlmodrio_toolchains//constraints/is_bookworm64:bookworm64_debug": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_linuxarm64debug//:shared"],
        "@rules_bzlmodrio_toolchains//constraints/is_systemcore:systemcore": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_linuxsystemcore//:shared"],
        "@rules_bzlmodrio_toolchains//constraints/is_systemcore:systemcore_debug": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_linuxsystemcoredebug//:shared"],
        "//conditions:default": [],
    }),
    visibility = ["@bzlmodrio-allwpilib//:__subpackages__"],
)

cc_library(
    name = "shared",
    srcs = [":shared_raw"],
    target_compatible_with = select({
        "@rules_bzlmodrio_toolchains//constraints/is_roborio:roborio": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    visibility = ["@bzlmodrio-allwpilib//:__subpackages__"],
    deps = [] + select({
        "@rules_bzlmodrio_toolchains//conditions:windows_arm64": [":shared_interface"],
        "@rules_bzlmodrio_toolchains//conditions:windows_x86_64": [":shared_interface"],
        "//conditions:default": [],
    }) + ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_headers//:headers"],
    alwayslink = 1,
)

