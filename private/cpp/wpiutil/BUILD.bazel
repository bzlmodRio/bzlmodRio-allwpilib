        "@rules_bzlmodrio_toolchains//conditions:linux_x86_64_debug": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_linuxx86-64debug//:jni"],
        "@rules_bzlmodrio_toolchains//conditions:osx": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_osxuniversal//:jni"],
        "@rules_bzlmodrio_toolchains//conditions:osx_debug": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_osxuniversaldebug//:jni"],
        "@rules_bzlmodrio_toolchains//conditions:windows_arm64": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_windowsarm64//:jni"],
        "@rules_bzlmodrio_toolchains//conditions:windows_arm64_debug": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_windowsarm64debug//:jni"],
        "@rules_bzlmodrio_toolchains//conditions:windows_x86_64": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_windowsx86-64//:jni"],
        "@rules_bzlmodrio_toolchains//conditions:windows_x86_64_debug": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_windowsx86-64debug//:jni"],
