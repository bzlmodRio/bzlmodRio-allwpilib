        "@rules_bzlmodrio_toolchains//conditions:windows_x86_64": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_windowsx86-64static//:static_libs"],
        "@rules_bzlmodrio_toolchains//conditions:windows_x86_64_debug": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_windowsx86-64staticdebug//:static_libs"],
        "@rules_bzlmodrio_toolchains//constraints/is_bookworm64:bookworm64": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_linuxarm64static//:static_libs"],
        "@rules_bzlmodrio_toolchains//constraints/is_bookworm64:bookworm64_debug": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_linuxarm64staticdebug//:static_libs"],
        "@rules_bzlmodrio_toolchains//constraints/is_systemcore:systemcore": ["@bazelrio_org_wpilib_wpiutil_wpiutil-cpp_linuxsystemcorestatic//:static_libs"],
